    "                ha=\"center\", va=\"center\", fontsize=11)\n",
    "ax.text(0.5, -0.25, \"majority vote  →  Yes (P = 0.6)\", transform=ax.transAxes,\n",
    "        ha=\"center\", fontsize=14, fontweight=\"bold\", color=\"tab:green\")\n",
