    "---\n",
    "title: \"Statistical Learning: An Introduction\"\n",
    "subtitle: \"ISLR, Chapter 2.1\"\n",
    "author: \"Bolong Tang · Peize Zhang · Yi Zhi Zhang\"\n",
    "date: today\n",
    "format:\n",
    "  revealjs:\n",
